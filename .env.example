# AIRunX Environment Configuration
# Supports both subscription-based auth (login) and API key auth

# Backend API Keys (choose based on your billing preference)
# API keys use pay-per-token billing; subscriptions use your plan quota
# ANTHROPIC_API_KEY=sk-ant-your_api_key_here
# OPENAI_API_KEY=sk-your_openai_api_key_here
# CURSOR_API_KEY=your_cursor_api_key_here

# GitHub Authentication (choose one)
# Option 1: Environment variable for server/CI environments
# GITHUB_TOKEN=ghp_your_token_here
# GH_TOKEN takes precedence over GITHUB_TOKEN (matches gh CLI behavior)
# Option 2: Use gh CLI authentication for local development
# Run: gh auth login
#
# Required scopes: repo, read:org
# Create at: https://github.com/settings/tokens/new?scopes=repo,read:org
# See README "GitHub Token" section for details.
#
# Note: For server deployments, set GITHUB_TOKEN as a system environment
# variable rather than in .env for better security.

# Optional: Timeout overrides
# AIRUNX_CHILD_TIMEOUT_MS=9000000    # Heartbeat child process timeout (default: 150 min)
# AIRUNX_TEST_TIMEOUT_MS=300000      # Pre-judge test gate timeout (default: 5 min)

# Optional: Cost controls
# AIRUNX_MAX_COST_PER_RUN=50         # Per-run cost cap in USD (default: $50, set to 0 to disable)

# Optional: Cost reconciliation (`airunx costs reconcile`)
# Provider admin keys let reconcile compare billed (API-key) ledger spend with
# what Anthropic / OpenAI actually billed. They are read only by the reconcile
# command and are stripped from every agent CLI environment.
#   - Use read-scoped / least-privilege admin keys where the provider supports it
#   - Prefer system environment variables over .env for non-local use
#   - Run reconcile from an operator context, not the heartbeat host, where possible
# Missing keys are not an error: that provider is reported non-reconcilable.
# ANTHROPIC_ADMIN_KEY=sk-ant-admin-your_admin_key_here
# OPENAI_ADMIN_KEY=sk-admin-your_admin_key_here
# Scope provider totals to the workspace/project dedicated to AIRUNX; without
# a scope, totals are org-wide and reported non-attributable.
# AIRUNX_ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace_id
# AIRUNX_OPENAI_PROJECT_ID=proj_your_project_id

# Optional: YOLO mode gate
# AIRUNX_ALLOW_YOLO=1                # Required to enable approval_mode: "yolo" (disables all sandboxing)
#                                    # Set in shell env for security — .env files can be project-controlled

# Optional: Extra environment variables for spawned CLI processes
# AIRUNX_EXTRA_ENV_VARS=MY_VAR,OTHER_VAR  # Comma-separated list of additional env vars to pass to agents

# Debug and display
# NO_COLOR=1                          # Disable colored output
DEBUG=false
